# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Neon Postgres
# Get from neon.tech → project → Connection Details → Pooled connection
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/kontaner?sslmode=require

# Cloudinary
# Get from cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Gemini
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key
GEMINI_VISION_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Password reset email (Gmail SMTP)
# Enable 2-Step Verification, then create an App Password in your Google Account.
GMAIL_SMTP_USER=your-account@gmail.com
GMAIL_SMTP_APP_PASSWORD=your-16-character-app-password
EMAIL_FROM=your-account@gmail.com
APP_URL=http://localhost:5173
